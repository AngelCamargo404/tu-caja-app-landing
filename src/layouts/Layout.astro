---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth scroll-pt-20">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Tu Caja App - Finanzas personales inteligentes, bóveda segura y asistente IA FINNO."
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.1.0/dist/cookieconsent.css"
    />

    <script
      is:inline
      type="text/partytown"
      src="https://www.googletagmanager.com/gtag/js?id=G-WN71XH25XY"></script>
    <script is:inline type="text/partytown">
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("js", new Date());

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
      });

      gtag("config", "G-WN71XH25XY");
    </script>

    <script is:inline type="text/partytown" data-category="analytics">
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("consent", "update", {
        ad_storage: "granted",
        ad_user_data: "granted",
        ad_personalization: "granted",
        analytics_storage: "granted",
      });
    </script>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans">
    <slot />

    <script is:inline type="module" src="/scripts/cookieconsent-config.js"
    ></script>

    <script>
      const observerOptions = {
        root: null,
        rootMargin: "0px",
        threshold: 0.1,
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      const elements = document.querySelectorAll(
        ".reveal, .reveal-left, .reveal-right, .reveal-scale, .reveal-blur",
      );
      elements.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

<style is:global>
  :root {
    --accent: 49, 176, 153;
    --accent-light: 41, 171, 226;
    --accent-dark: 28, 38, 52;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent)),
      rgb(var(--accent-light)) 30%,
      white 60%
    );
  }

  /* Animaciones de Scroll */
  .reveal,
  .reveal-left,
  .reveal-right,
  .reveal-scale,
  .reveal-blur {
    opacity: 0;
    transition: all 1s cubic-bezier(0.5, 0, 0, 1);
  }

  .reveal,
  .reveal-blur {
    transform: translateY(30px);
  }

  .reveal-blur {
    filter: blur(10px);
  }

  .reveal-left {
    transform: translateX(-30px);
  }

  .reveal-right {
    transform: translateX(30px);
  }

  .reveal-scale {
    transform: scale(0.9);
  }

  .active.reveal,
  .active.reveal-left,
  .active.reveal-right,
  .active.reveal-blur {
    opacity: 1;
    transform: translate(0);
    filter: blur(0);
  }

  .active.reveal-scale {
    opacity: 1;
    transform: scale(1);
  }

  .delay-100 {
    transition-delay: 100ms;
  }
  .delay-200 {
    transition-delay: 200ms;
  }
  .delay-300 {
    transition-delay: 300ms;
  }
  .delay-400 {
    transition-delay: 400ms;
  }
  .delay-500 {
    transition-delay: 500ms;
  }
  .delay-700 {
    transition-delay: 700ms;
  }
</style>
