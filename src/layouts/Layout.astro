---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth scroll-pt-20">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Tu Caja App - Finanzas personales inteligentes, bóveda segura y asistente IA FINNO." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-slate-50 text-slate-900 font-sans">
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--accent: 49, 176, 153;
		--accent-light: 41, 171, 226;
		--accent-dark: 28, 38, 52;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);
	}
</style>
