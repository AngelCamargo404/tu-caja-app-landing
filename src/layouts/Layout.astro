---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth scroll-pt-20">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Tu Caja App - Finanzas personales inteligentes, bóveda segura y asistente IA FINNO."
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Inline blocking script to prevent flash of wrong theme -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const currentHour = new Date().getHours();
        const isNight = currentHour >= 19 || currentHour < 7;
        if (stored === 'dark' || (!stored && (prefersDark || isNight))) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
    />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.1.0/dist/cookieconsent.css"
    />

    <script
      is:inline
      type="text/partytown"
      src="https://www.googletagmanager.com/gtag/js?id=G-WN71XH25XY"></script>
    <script is:inline type="text/partytown">
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("js", new Date());

      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
      });

      // Solo analítica: desactivamos las funciones publicitarias de GA4
      // (evita las APIs obsoletas Attribution Reporting y Shared Storage)
      gtag("config", "G-WN71XH25XY", {
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
      });
    </script>

    <script is:inline type="text/partytown" data-category="analytics">
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      // Concedemos únicamente el almacenamiento analítico; las señales
      // publicitarias permanecen denegadas (no usamos cookies de publicidad).
      gtag("consent", "update", {
        analytics_storage: "granted",
      });
    </script>
  </head>
  <body
    class="bg-slate-50 dark:bg-dark-800 text-slate-900 dark:text-slate-100 font-sans antialiased selection:bg-primary/30 dark:selection:bg-primary/40 selection:text-secondary-700 dark:selection:text-primary-200"
  >
    <slot />

    <script is:inline type="module" src="/scripts/cookieconsent-config.js"
    ></script>

    <script>
      const observerOptions = {
        root: null,
        rootMargin: "0px",
        threshold: 0.1,
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      const elements = document.querySelectorAll(
        ".reveal, .reveal-left, .reveal-right, .reveal-scale, .reveal-blur",
      );
      elements.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

<style is:global>
  :root {
    --font-display: "Plus Jakarta Sans", system-ui, sans-serif;
    --font-body: "DM Sans", system-ui, sans-serif;
    --brand-primary: 49, 176, 153;
    --brand-secondary: 34, 57, 107;
    --brand-accent: 41, 171, 226;
    --brand-dark: 28, 38, 52;
    --accent-gradient: linear-gradient(
      135deg,
      rgb(var(--brand-primary)),
      rgb(var(--brand-accent)) 50%,
      rgb(var(--brand-secondary)) 100%
    );
  }

  html {
    scroll-behavior: smooth;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-display);
  }

  h1 {
    line-height: 1.35;
  }

  h2 {
    line-height: 1.45;
  }

  /* Títulos de sección que suelen ocupar dos líneas */
  .section-heading {
    text-wrap: balance;
    line-height: 1.2;
  }

  @media (min-width: 768px) {
    .section-heading {
      line-height: 1.15;
    }
  }

  @media (min-width: 1024px) {
    h1.section-heading {
      line-height: 1.1;
    }
  }

  h3,
  h4 {
    line-height: 1.35;
  }

  h5,
  h6 {
    line-height: 1.4;
  }

  p,
  li {
    line-height: 1.75;
  }

  .prose :where(p, li, blockquote) {
    line-height: 1.75;
  }

  .prose :where(h1) {
    line-height: 1.35;
  }

  .prose :where(h2, h3) {
    line-height: 1.45;
  }

  .prose :where(h4, h5, h6) {
    line-height: 1.35;
  }

  p,
  #main-nav a,
  #main-nav button {
    font-family: var(--font-body);
  }

  /* Branded text selection on links/buttons in dark sections */
  .bg-dark ::selection,
  .bg-secondary ::selection {
    background: rgba(49, 176, 153, 0.45);
    color: #fff;
  }

  /* Animated gradient text helper */
  .text-gradient-brand {
    background-image: linear-gradient(
      90deg,
      rgb(var(--brand-primary)),
      rgb(var(--brand-accent)),
      rgb(var(--brand-primary))
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shimmer 4s linear infinite;
  }

  /* Branded scrollbar (non-essential progressive enhancement) */
  ::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }
  ::-webkit-scrollbar-track {
    background: #f1f5f9;
  }
  .dark ::-webkit-scrollbar-track {
    background: #1e293b;
  }
  ::-webkit-scrollbar-thumb {
    background: linear-gradient(
      180deg,
      rgb(var(--brand-primary)),
      rgb(var(--brand-accent))
    );
    border-radius: 9999px;
  }

  /* Decorative animated blobs */
  .blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(60px);
    opacity: 0.45;
    pointer-events: none;
    z-index: 0;
  }

  /* Animaciones de Scroll */
  .reveal,
  .reveal-left,
  .reveal-right,
  .reveal-scale,
  .reveal-blur {
    opacity: 0;
    transition: all 1s cubic-bezier(0.5, 0, 0, 1);
  }

  .reveal,
  .reveal-blur {
    transform: translateY(30px);
  }

  .reveal-blur {
    filter: blur(10px);
  }

  .reveal-left {
    transform: translateX(-30px);
  }

  .reveal-right {
    transform: translateX(30px);
  }

  .reveal-scale {
    transform: scale(0.9);
  }

  .active.reveal,
  .active.reveal-left,
  .active.reveal-right,
  .active.reveal-blur {
    opacity: 1;
    transform: translate(0);
    filter: blur(0);
  }

  .active.reveal-scale {
    opacity: 1;
    transform: scale(1);
  }

  .delay-100 {
    transition-delay: 100ms;
  }
  .delay-200 {
    transition-delay: 200ms;
  }
  .delay-300 {
    transition-delay: 300ms;
  }
  .delay-400 {
    transition-delay: 400ms;
  }
  .delay-500 {
    transition-delay: 500ms;
  }
  .delay-700 {
    transition-delay: 700ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .reveal-left,
    .reveal-right,
    .reveal-scale,
    .reveal-blur {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      transition: none !important;
    }
  }

  /* Cookie Consent — brand overrides */
  :root {
    --cc-font-family: inherit;
    --cc-modal-border-radius: 1.25rem;
    --cc-btn-border-radius: 9999px;

    /* Modal background y textos — alto contraste */
    --cc-bg: #ffffff;
    --cc-primary-color: #0f1b31;       /* secondary-800: texto principal oscuro */
    --cc-secondary-color: #22396B;     /* secondary-500: texto secundario */

    /* Botón primario: teal sólido, texto blanco (contraste AA) */
    --cc-btn-primary-bg: #1F7263;
    --cc-btn-primary-color: #ffffff;
    --cc-btn-primary-hover-bg: #175548;

    /* Botón secundario: navy muy tenue con borde, texto navy */
    --cc-btn-secondary-bg: #E7ECF6;
    --cc-btn-secondary-color: #0f1b31;
    --cc-btn-secondary-hover-bg: #CFD9ED;

    --cc-separator-border-color: #CFD9ED;
    --cc-cookie-category-block-bg: #E8F8F4;
    --cc-cookie-category-block-border: #70D5BC;
    --cc-cookie-category-block-hover-bg: #CFF1E8;
    --cc-toggle-on-bg: #31B099;
    --cc-toggle-off-bg: #9298A4;
    --cc-toggle-readonly-bg: #A0E3D2;
    --cc-overlay-bg: rgba(15, 27, 49, 0.55);
    --cc-webkit-scrollbar-bg: #E8F8F4;
    --cc-webkit-scrollbar-bg-hover: #70D5BC;
    --cc-link-color: #1F7263;
  }

  .dark {
    --cc-bg: #10161E;
    --cc-primary-color: #f1f5f9;
    --cc-secondary-color: #C9CCD2;     /* gris claro legible sobre fondo oscuro */

    --cc-btn-primary-bg: #1F7263;
    --cc-btn-primary-color: #ffffff;
    --cc-btn-primary-hover-bg: #175548;

    --cc-btn-secondary-bg: #1C2634;
    --cc-btn-secondary-color: #e2e8f0;
    --cc-btn-secondary-hover-bg: #393F4D;

    --cc-separator-border-color: #393F4D;
    --cc-cookie-category-block-bg: #0F1B31;
    --cc-cookie-category-block-border: #27907D;
    --cc-cookie-category-block-hover-bg: #175548;
    --cc-toggle-on-bg: #31B099;
    --cc-toggle-off-bg: #5C6577;
    --cc-toggle-readonly-bg: #175548;
    --cc-overlay-bg: rgba(5, 7, 9, 0.7);
    --cc-webkit-scrollbar-bg: #1C2634;
    --cc-webkit-scrollbar-bg-hover: #27907D;
    --cc-link-color: #50C4AA;
  }

  /* Título en negrita */
  #cc-main .cm__title {
    font-weight: 700;
    color: var(--cc-primary-color);
  }

  /* Descripción con buen contraste */
  #cc-main .cm__desc {
    color: var(--cc-secondary-color);
  }

  /* Links dentro del modal y descripción */
  #cc-main .cm__footer a,
  #cc-main .cc-link {
    color: var(--cc-link-color);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #cc-main .cm__footer a:hover,
  #cc-main .cc-link:hover {
    opacity: 0.8;
  }

  /* Sombra y borde tenue al modal */
  #cc-main .cm {
    box-shadow:
      0 4px 24px rgba(15, 27, 49, 0.12),
      0 1px 4px rgba(15, 27, 49, 0.06);
    border: 1px solid rgba(49, 176, 153, 0.2);
  }

  .dark #cc-main .cm {
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.4),
      0 1px 4px rgba(0, 0, 0, 0.2);
    border-color: rgba(49, 176, 153, 0.15);
  }

  /* Botón preferencias (texto link) con contraste claro */
  #cc-main .cm__btn-group .cm__btn--secondary:last-child {
    background: transparent;
    color: var(--cc-secondary-color);
    font-weight: 500;
  }
  #cc-main .cm__btn-group .cm__btn--secondary:last-child:hover {
    background: transparent;
    color: var(--cc-primary-color);
    text-decoration: underline;
  }
</style>
