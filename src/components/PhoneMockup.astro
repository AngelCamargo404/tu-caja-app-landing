---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  imageSrc?: ImageMetadata;
  imageSrcDark?: ImageMetadata;
  imageAlt?: string;
  class?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  variant?: "ios" | "android";
  size?: "carousel" | "feature" | "fill";
}

const {
  imageSrc,
  imageSrcDark,
  imageAlt = "",
  class: className = "",
  loading = "lazy",
  fetchpriority,
  variant = "ios",
  size = "carousel",
} = Astro.props;

const hasThemeSwap = Boolean(imageSrc && imageSrcDark);
const sizeClass =
  size === "feature"
    ? "phone-frame--feature"
    : size === "fill"
      ? "phone-frame--fill"
      : "phone-frame--carousel";

// Responsive delivery: el teléfono nunca se muestra a más de ~360px de ancho,
// así que generamos un srcset y dejamos que el navegador elija el tamaño justo
// (evita descargar la imagen fuente completa de ~924px).
const imageWidths = [240, 320, 440, 620, 880];
const imageSizes =
  size === "feature"
    ? "(max-width: 768px) 50vw, 320px"
    : size === "fill"
      ? "(max-width: 768px) 60vw, 320px"
      : "(max-width: 768px) 70vw, 360px";
---

<div
  class:list={[
    "phone-frame",
    sizeClass,
    variant === "android" && "phone-frame-android",
    className,
  ]}
>
  {
    variant === "android" ? (
      <>
        <div class="phone-camera-hole" aria-hidden="true" />
        <div class="phone-screen phone-screen-android">
          {hasThemeSwap ? (
            <>
              <Image
                src={imageSrc!}
                alt={imageAlt}
                class="phone-shot phone-shot-light absolute inset-0 w-full h-full object-cover"
                loading={loading}
                fetchpriority={fetchpriority}
                widths={imageWidths}
                sizes={imageSizes}
              />
              <Image
                src={imageSrcDark!}
                alt={imageAlt}
                class="phone-shot phone-shot-dark absolute inset-0 w-full h-full object-cover"
                loading={loading}
                fetchpriority={fetchpriority}
                widths={imageWidths}
                sizes={imageSizes}
              />
            </>
          ) : imageSrc ? (
            <Image
              src={imageSrc}
              alt={imageAlt}
              class="absolute inset-0 w-full h-full object-cover"
              loading={loading}
              fetchpriority={fetchpriority}
              widths={imageWidths}
              sizes={imageSizes}
            />
          ) : (
            <slot />
          )}
        </div>
      </>
    ) : (
      <>
        <div class="phone-notch" aria-hidden="true" />
        <div class="phone-screen">
          {hasThemeSwap ? (
            <>
              <Image
                src={imageSrc!}
                alt={imageAlt}
                class="phone-shot phone-shot-light absolute inset-0 w-full h-full object-cover"
                loading={loading}
                fetchpriority={fetchpriority}
                widths={imageWidths}
                sizes={imageSizes}
              />
              <Image
                src={imageSrcDark!}
                alt={imageAlt}
                class="phone-shot phone-shot-dark absolute inset-0 w-full h-full object-cover"
                loading={loading}
                fetchpriority={fetchpriority}
                widths={imageWidths}
                sizes={imageSizes}
              />
            </>
          ) : imageSrc ? (
            <Image
              src={imageSrc}
              alt={imageAlt}
              class="absolute inset-0 w-full h-full object-cover"
              loading={loading}
              fetchpriority={fetchpriority}
              widths={imageWidths}
              sizes={imageSizes}
            />
          ) : (
            <slot />
          )}
        </div>
      </>
    )
  }
</div>

<style is:global>
  .phone-frame {
    position: relative;
    aspect-ratio: 9 / 19.5;
    background: #0a0e13;
    border-radius: 2.25rem;
    padding: 0.55rem;
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.06) inset;
    transition:
      transform 0.4s ease,
      box-shadow 0.4s ease;
  }

  .phone-frame--carousel {
    width: clamp(230px, 42vw, 360px);
  }

  .phone-frame--feature {
    width: clamp(230px, 38vw, 320px);
  }

  .phone-frame--fill {
    width: 100%;
    height: 100%;
    aspect-ratio: unset;
  }

  .phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 1.75rem;
    overflow: hidden;
    background: #10161e;
  }

  .phone-notch {
    position: absolute;
    top: 0.55rem;
    left: 50%;
    transform: translateX(-50%);
    width: 38%;
    height: 1.1rem;
    background: #0a0e13;
    border-bottom-left-radius: 0.9rem;
    border-bottom-right-radius: 0.9rem;
    z-index: 2;
  }

  .phone-frame-android {
    border-radius: 1.75rem;
  }

  .phone-screen-android {
    border-radius: 1.35rem;
    background: linear-gradient(160deg, #0f1b31 0%, #08111d 100%);
  }

  .phone-camera-hole {
    position: absolute;
    top: 0.9rem;
    left: 50%;
    transform: translateX(-50%);
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 9999px;
    background: #0a0e13;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.04);
    z-index: 2;
  }

  .phone-shot-dark {
    display: none;
  }

  .dark .phone-shot-light {
    display: none;
  }

  .dark .phone-shot-dark {
    display: block;
  }
</style>
