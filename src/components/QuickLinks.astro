---
const links = [
  {
    href: "/blog",
    label: "Blog",
    description: "Recursos, consejos y estrategias para mejorar tu relación con el dinero.",
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
    </svg>`,
    accent: "from-primary/10 to-accent/10 dark:from-primary/20 dark:to-accent/20",
    iconColor: "text-primary dark:text-primary",
  },
  {
    href: "/nosotros",
    label: "Sobre Nosotros",
    description: "Conoce el equipo, la misión y los valores detrás de Tu Caja App.",
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
      <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
    </svg>`,
    accent: "from-secondary/10 to-primary/10 dark:from-secondary/20 dark:to-primary/20",
    iconColor: "text-secondary dark:text-accent",
  },
  {
    href: "/contacto",
    label: "Contacto",
    description: "¿Tienes preguntas o quieres colaborar? Escríbenos, estamos para ayudarte.",
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
    </svg>`,
    accent: "from-accent/10 to-secondary/10 dark:from-accent/20 dark:to-secondary/20",
    iconColor: "text-accent dark:text-accent",
  },
];
---

<section
  id="accesos-rapidos"
  class="relative py-20 bg-slate-50 dark:bg-dark-900 overflow-hidden"
>
  <!-- Decorative blurs -->
  <div
    class="absolute -top-16 left-1/4 w-64 h-64 rounded-full bg-primary/10 dark:bg-primary/15 blur-3xl pointer-events-none"
  ></div>
  <div
    class="absolute bottom-0 right-1/4 w-64 h-64 rounded-full bg-accent/10 dark:bg-accent/15 blur-3xl pointer-events-none"
  ></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center mb-12 reveal">
      <h2 class="section-heading text-2xl md:text-3xl font-bold text-secondary dark:text-white">
        Todo lo que necesitas saber
      </h2>
      <p class="mt-3 text-slate-600 dark:text-slate-400 max-w-xl mx-auto">
        Accede a nuestro blog, conoce al equipo o contáctanos directamente.
      </p>
    </div>

    <!-- Cards grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="reveal group relative flex flex-col rounded-3xl border border-slate-200 dark:border-dark-500 bg-white dark:bg-dark-800 p-7 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden"
          >
            <!-- Gradient background on hover -->
            <div
              class={`absolute inset-0 bg-gradient-to-br ${link.accent} opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-3xl`}
            />

            <div class="relative z-10 flex flex-col h-full">
              <!-- Icon -->
              <div
                class={`inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-slate-100 dark:bg-dark-700 group-hover:bg-white/80 dark:group-hover:bg-dark-600 transition-colors duration-300 mb-5 ${link.iconColor}`}
                set:html={link.icon}
              />

              <!-- Text -->
              <h3 class="text-lg font-bold text-secondary dark:text-white group-hover:text-secondary dark:group-hover:text-white">
                {link.label}
              </h3>
              <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 flex-1">
                {link.description}
              </p>

              <!-- Arrow CTA -->
              <div class="mt-5 flex items-center gap-1.5 text-sm font-semibold text-primary dark:text-primary group-hover:gap-3 transition-all duration-300">
                <span>Ver más</span>
                <svg
                  class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  stroke-width="2.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                  />
                </svg>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
