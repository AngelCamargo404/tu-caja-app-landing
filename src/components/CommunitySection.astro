---
// Puedes personalizar el enlace de tu grupo de Telegram aquí
const telegramGroupUrl = "https://t.me/+UeNBzD5prKNhYmMx";
---

<section id="comunidad" class="py-20 bg-gradient-to-r from-primary to-accent">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="flex justify-center mb-6">
      <div class="bg-white/20 backdrop-blur-md rounded-full p-6 reveal-scale">
        <svg
          class="w-16 h-16 text-white"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.223-.548.223l.188-2.85 5.18-4.68c.223-.198-.054-.308-.346-.11l-6.4 4.03-2.76-.918c-.6-.187-.612-.6.125-.89l10.782-4.156c.5-.18.943.112.78.89z"
          ></path>
        </svg>
      </div>
    </div>

    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 reveal">
      Únete a Nuestra Comunidad
    </h2>

    <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto reveal delay-100">
      Conecta con otros usuarios, comparte consejos financieros, obtén soporte y
      sé el primero en conocer las novedades de Tu Caja App.
    </p>

    <a
      href={telegramGroupUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-3 bg-white text-primary px-8 py-4 rounded-full font-bold text-lg hover:bg-gray-100 transition-all hover:scale-105 shadow-lg reveal delay-200"
    >
      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
        <path
          d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.223-.548.223l.188-2.85 5.18-4.68c.223-.198-.054-.308-.346-.11l-6.4 4.03-2.76-.918c-.6-.187-.612-.6.125-.89l10.782-4.156c.5-.18.943.112.78.89z"
        ></path>
      </svg>
      Únete al Grupo de Telegram
    </a>

    <div class="mt-8 flex justify-center gap-8 text-white/80 reveal delay-300">
      <div class="flex items-center gap-2">
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
        <span>Noticias al Instante</span>
      </div>
      <div class="flex items-center gap-2">
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
        <span>Soporte Directo</span>
      </div>
    </div>
  </div>
</section>
