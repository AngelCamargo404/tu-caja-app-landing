---
import DownloadButtons from "./DownloadButtons.astro";
import { Image } from "astro:assets";
import mascotHead from "../assets/images/MASCOTA HEAD.png";
import heroImage from "../assets/images/Captura2.png";
---

<section
  id="inicio"
  class="relative pt-32 pb-24 px-4 sm:px-6 lg:px-8 bg-brand-gradient-soft overflow-hidden"
>
  <!-- Decorative animated blobs in brand colors -->
  <div
    class="blob bg-primary/40 w-[28rem] h-[28rem] -top-32 -left-24 animate-float-slower"
  >
  </div>
  <div
    class="blob bg-accent/40 w-[24rem] h-[24rem] top-20 -right-20 animate-float-slow"
  >
  </div>
  <div
    class="blob bg-secondary/20 w-[18rem] h-[18rem] bottom-0 left-1/3 animate-float-slower"
  >
  </div>

  <div
    class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-center relative z-10"
  >
    <div class="text-center lg:text-left z-10 relative">
      <!-- Mascot Image: Static and centered on mobile, Absolute positioned on desktop -->
      <div
        class="w-32 h-32 mx-auto lg:mx-0 mb-6 lg:absolute lg:-top-28 lg:mb-0 z-20 animate-float-slow reveal-scale"
      >
        <Image
          src={mascotHead}
          alt="Finno Mascot"
          class="w-full h-full object-contain drop-shadow-[0_15px_25px_rgba(34,57,107,0.35)]"
        />
      </div>

      <span
        class="inline-flex items-center gap-2 mb-5 px-4 py-1.5 rounded-full bg-white/70 backdrop-blur border border-primary/30 text-secondary text-xs sm:text-sm font-semibold shadow-sm reveal"
      >
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        Tu salud financiera, en una sola app
      </span>

      <h1
        class="text-5xl lg:text-6xl font-extrabold tracking-tight text-secondary mb-6 leading-tight reveal delay-100"
      >
        Tus finanzas, <span class="text-gradient-brand whitespace-nowrap"
          >bajo control.</span
        >
      </h1>
      <p
        class="text-xl text-slate-600 mb-8 max-w-2xl mx-auto lg:mx-0 reveal delay-200"
      >
        Gestiona tu dinero, guarda tus contraseñas y cumple tus metas con la
        ayuda de <span class="font-semibold text-primary-700">FINNO</span>, tu
        asistente financiero personal con IA.
      </p>
      <div class="reveal delay-300">
        <DownloadButtons />
      </div>
    </div>
    <div
      class="relative mx-auto lg:ml-auto w-full max-w-sm lg:max-w-md reveal-scale delay-500"
    >
      <!-- Phone Mockup Container -->
      <div
        class="relative bg-dark rounded-[3rem] p-4 shadow-2xl border-4 border-dark-700 aspect-[9/19] overflow-hidden animate-float-slow"
      >
        <!-- Screen Content -->
        <div
          class="h-full w-full bg-white rounded-[2rem] overflow-hidden flex flex-col relative"
        >
          <Image
            src={heroImage}
            alt="Tu Caja App Screenshot"
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>
        <!-- Notch -->
        <div
          class="absolute top-0 left-1/2 transform -translate-x-1/2 w-40 h-6 bg-dark rounded-b-2xl z-20"
        >
        </div>
      </div>
      <!-- Decorative Elements -->
      <div
        class="absolute -z-10 top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[120%] h-[100%] bg-gradient-to-tr from-primary/40 via-accent/40 to-secondary/30 rounded-full blur-3xl opacity-70"
      >
      </div>
    </div>
  </div>
</section>
