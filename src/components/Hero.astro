---
import DownloadButtons from "./DownloadButtons.astro";
import { Image } from "astro:assets";
import mascotHead from "../assets/images/MASCOTA HEAD.png";
import heroImage from "../assets/images/Captura2.png";
---

<section
  id="inicio"
  class="pt-32 pb-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-blue-50 to-white overflow-hidden"
>
  <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-center">
    <div class="text-center lg:text-left z-10 relative">
      <!-- Mascot Image: Static and centered on mobile, Absolute positioned on desktop -->
      <div
        class="w-32 h-32 mx-auto lg:mx-0 mb-6 lg:absolute lg:-top-28 lg:mb-0 z-20 animate-bounce reveal-scale"
      >
        <Image
          src={mascotHead}
          alt="Finno Mascot"
          class="w-full h-full object-contain drop-shadow-xl"
        />
      </div>

      <h1
        class="text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 mb-6 leading-tight reveal delay-100"
      >
        Tus finanzas, <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-accent whitespace-nowrap"
          >bajo control.</span
        >
      </h1>
      <p
        class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto lg:mx-0 reveal delay-200"
      >
        Gestiona tu dinero, guarda tus contraseñas y cumple tus metas con la
        ayuda de FINNO, tu asistente financiero personal con IA.
      </p>
      <div class="reveal delay-300">
        <DownloadButtons />
      </div>
    </div>
    <div
      class="relative mx-auto lg:ml-auto w-full max-w-sm lg:max-w-md reveal-scale delay-500"
    >
      <!-- Phone Mockup Container -->
      <div
        class="relative bg-gray-900 rounded-[3rem] p-4 shadow-2xl border-4 border-gray-800 aspect-[9/19] overflow-hidden"
      >
        <!-- Screen Content -->
        <div
          class="h-full w-full bg-white rounded-[2rem] overflow-hidden flex flex-col relative"
        >
          <Image
            src={heroImage}
            alt="Tu Caja App Screenshot"
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>
        <!-- Notch -->
        <div
          class="absolute top-0 left-1/2 transform -translate-x-1/2 w-40 h-6 bg-gray-900 rounded-b-2xl z-20"
        >
        </div>
      </div>
      <!-- Decorative Elements -->
      <div
        class="absolute -z-10 top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[120%] h-[100%] bg-gradient-to-tr from-blue-200 to-purple-200 rounded-full blur-3xl opacity-40"
      >
      </div>
    </div>
  </div>
</section>
