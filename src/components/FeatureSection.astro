---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  imageSrc?: ImageMetadata;
  imageAlt?: string;
  reversed?: boolean;
  id?: string;
}

const { title, description, imageSrc, imageAlt = "", reversed = false, id } = Astro.props;
---

<section id={id} class={`py-20 px-4 sm:px-6 lg:px-8 ${reversed ? 'bg-slate-50' : 'bg-white'}`}>
  <div class="max-w-7xl mx-auto flex flex-col items-center gap-12 lg:gap-24" class:list={[reversed ? 'lg:flex-row-reverse' : 'lg:flex-row']}>
    <div class="flex-1 space-y-6 text-center lg:text-left">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900">{title}</h2>
      <p class="text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto lg:mx-0">
        {description}
      </p>
      <slot name="extra" />
    </div>
    
    <div class="flex-1 w-full max-w-md lg:max-w-xl flex justify-center">
        <!-- Phone Mockup Frame -->
        <div class="relative bg-gray-900 rounded-[2.5rem] p-3 shadow-2xl border-4 border-gray-800 w-64 md:w-72 lg:w-80">
            <!-- Screen Content -->
            <div class="bg-gray-800 rounded-[2rem] overflow-hidden relative aspect-[9/19]">
                {imageSrc ? (
                <Image src={imageSrc} alt={imageAlt} class="absolute inset-0 w-full h-full object-cover" />
                ) : (
                <div class="w-full h-full bg-gray-700 flex items-center justify-center text-gray-500">
                    <span class="text-sm">No Image</span>
                </div>
                )}
            </div>
             <!-- Notch -->
             <div class="absolute top-0 left-1/2 transform -translate-x-1/2 w-32 h-5 bg-gray-900 rounded-b-xl z-20"></div>
        </div>
    </div>
  </div>
</section>
