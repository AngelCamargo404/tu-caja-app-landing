---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import ScreenshotShowcase from "../components/ScreenshotShowcase.astro";
import FeatureSection from "../components/FeatureSection.astro";
import CommunitySection from "../components/CommunitySection.astro";
import QuickLinks from "../components/QuickLinks.astro";
import Footer from "../components/Footer.astro";

// Import images
import presupuestosImage from "../assets/images/ios-presupuestos-dark.png";
import calculadoraImageLight from "../assets/images/ios-calculadora-light.png";
import calculadoraImageDark from "../assets/images/ios-calculadora-dark.png";
import estadisticasImageLight from "../assets/images/ios-categorias-light.png";
import estadisticasImageDark from "../assets/images/ios-categorias-dark.png";
---

<Layout title="Tu Caja App - Finanzas Personales Inteligentes">
  <Navbar />

  <main>
    <div class="landing-intro relative overflow-hidden bg-brand-gradient-soft dark:bg-brand-gradient-soft-dark">
      <Hero />
      <ScreenshotShowcase />
    </div>

    <section id="caracteristicas">
      <FeatureSection
        id="presupuestos"
        eyebrow="Presupuestos"
        title="Cada centavo con un propósito"
        description="Crea presupuestos detallados por categoría, divide tus fondos antes de gastarlos y mantén el rumbo con alertas inteligentes cuando te acercas a tu límite."
        imageSrc={presupuestosImage}
        imageAlt="Gestión de presupuestos"
        reversed={true}
        highlights={[
          { icon: "chart", title: "Por categoría", text: "Crea reglas finas para cada tipo de gasto." },
          { icon: "bell", title: "Alertas en tiempo real", text: "Avisos cuando te acercas al tope." },
          { icon: "calendar", title: "Comparativas", text: "Mide mes contra mes y mejora cada vez." },
        ]}
      />

      <FeatureSection
        id="calculadora"
        eyebrow="Calculadora de divisas"
        title="Convierte entre monedas al instante"
        description="Consulta tasas de cambio actualizadas y convierte montos entre tus monedas favoritas sin salir de la app. Ideal para viajes, compras internacionales o cuando manejas más de una divisa."
        imageSrc={calculadoraImageLight}
        imageSrcDark={calculadoraImageDark}
        imageAlt="Calculadora de divisas"
        highlights={[
          { icon: "spark", title: "Conversión rápida", text: "Ingresa un monto y obtén el equivalente al momento." },
          { icon: "chart", title: "Tasas actualizadas", text: "Trabaja con tipos de cambio recientes y confiables." },
          { icon: "target", title: "Varias monedas", text: "Alterna entre las divisas que usas con frecuencia." },
        ]}
      />

      <FeatureSection
        id="estadisticas"
        eyebrow="Estadísticas"
        title="Entiende a dónde va tu dinero"
        description="Gráficas interactivas y reportes claros para descubrir patrones, identificar fugas y tomar decisiones financieras con criterio, no con corazonadas."
        imageSrc={estadisticasImageLight}
        imageSrcDark={estadisticasImageDark}
        imageAlt="Gráficas de estadísticas financieras"
        reversed={true}
        highlights={[
          { icon: "chart", title: "Gráficas vivas", text: "Filtra por categoría, periodo o método." },
          { icon: "spark", title: "Patrones ocultos", text: "Descubre dónde se va realmente tu dinero." },
          { icon: "calendar", title: "Reportes claros", text: "Exporta resúmenes cuando los necesites." },
        ]}
      />
    </section>

    <QuickLinks />

    <CommunitySection />

  </main>

  <Footer />
</Layout>
